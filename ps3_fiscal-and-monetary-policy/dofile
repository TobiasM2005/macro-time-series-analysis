* Aufgabe 1

version 19.5
set more off
clear all

use "..\FISCALREACTION.dta", clear

*a)
tsset DATE
order DATE

*Plots
twoway tsline PD_GER PD_FRA, legend(position(6)) title("Primärdefizitquoten in Deutschland und Frankreich") subtitle("Darstellung von 1995 bis 2024") xlabel(1995(5)2025)

twoway tsline DEBT_GER DEBT_FRA , legend(position(6)) title("Schuldenstandsquoten in Deutschland und Frankreich") subtitle("Darstellung von 1995 bis 2024") xlabel(1995(5)2025)

*b) und c) 
reg PD_GER L.DEBT_GER GAP_GER
estat dwatson 
estat bgodfrey
estat hettest
local rho_GER = _b[L.DEBT_GER]

reg PD_FRA L.DEBT_FRA GAP_FRA
estat dwatson
estat bgodfrey
estat hettest
local rho_FRA = _b[L.DEBT_FRA]

*Wachstumrate gamma berechnen
gen GAMMA_GER = (GDPR_GER - L.GDPR_GER)/L.GDPR_GER
gen GAMMA_FRA = (GDPR_FRA - L.GDPR_FRA)/L.GDPR_FRA

* max. kompatibles r
sum GAMMA_GER 
local gamma_GER = r(mean)
di (1 - `rho_GER')*(1+ `gamma_GER') -1

sum GAMMA_FRA
local gamma_FRA = r(mean)
di (1 - `rho_FRA')*(1+ `gamma_FRA') -1

prais PD_GER L.DEBT_GER GAP_GER
prais PD_FRA L.DEBT_FRA GAP_FRA
*Aufgabe 2
*b)
use "C:\Users\tobia\Documents\Studium\4. Semester\makroökonomisches Seminar\3.Problemset\Data_PS3\TAYLORRULE.dta", clear

tsset DATE

*Berechnung der Inflatiosnrate
gen pi = ((HICP-L4.HICP)/L4.HICP)*100

*Outpulücke berechnen
gen BIP_ln = ln(GDP)
tsfilter hp GAP = BIP_ln, smooth(1600)

*in Prozent umrechnen
gen y_gap = GAP * 100

*Modelle schätzen
reg ESTR pi y_gap if DATE >= yq(1999,1)
estat dwatson
estat bgodfrey, lags(1)

reg ESTR pi y_gap L.ESTR if DATE >= yq(1999,1)
estat bgodfrey, lags(1)

nlcom (g_pi: _b[pi] / (1- _b[L.ESTR])) ///
(g_y: _b[y_gap] / (1- _b[L.ESTR])) ///
(alpha: _b[_cons] / (1- _b[L.ESTR]))

*Grafik erstellen
tsline ESTR pi if DATE >= yq(1999,1), title("EZB-Zinspolitik und Inflation (1999-2025)") ytitle("Prozent") tline(2008q3, lcolor(blue)) legend(label(1 "Zinssatz (ESTR)") label (2 "Inflation (pi)"))

*Chow-TEST
gen crisis = (DATE >= yq(2008,3))

gen pi_crisis = pi * crisis
gen y_gap_crisis = y_gap * crisis

regress ESTR pi y_gap crisis pi_crisis y_gap_crisis if DATE >= yq(1999,1)

test crisis pi_crisis y_gap_crisis

*c)

gen DATE_sq = DATE^2

reg BIP_ln DATE DATE_sq
predict GAP2, resid
gen y_gap2 = GAP2 *100

tsline y_gap y_gap2  if DATE > yq(1999,1), ///
title("Vergleich der Outputlücken-Maße") ///
ytitle("Abweichung vom Trend in Prozent") ///
legend(label(1 "HP-Filter") label(2 "Quadratischer Trend")) 

*Schätzung aus b) um  Inflationerwartung erweitert
reg ESTR F1.pi y_gap L.ESTR if DATE > yq(1999,1)
estat bgodfrey, lags(1)

nlcom (g_pi: _b[F1.pi] / (1- _b[L.ESTR])) ///
(g_y: _b[y_gap] / (1- _b[L.ESTR])) ///
(alpha: _b[_cons] / (1- _b[L.ESTR]))

